PORT=4000
NODE_ENV=development

# Local:   postgresql://postgres:postgres@localhost:5432/medicare
# Railway: paste the DATABASE_URL from your Postgres service
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/medicare

# Long random string — generate at https://randomkeygen.com
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5500,http://127.0.0.1:5500